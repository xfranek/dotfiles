# Brewfile — shell tooling for the pro zsh setup
# Applied automatically by chezmoi via run_onchange_ hook (`brew bundle`).

# --- core CLI ---
brew "zoxide"        # smarter cd (mapped onto `cd`)
brew "starship"      # prompt
brew "eza"           # modern ls
brew "bat"           # modern cat (syntax highlight)
brew "fd"            # modern find
brew "fzf"           # fuzzy finder (Ctrl-R / Ctrl-T / Alt-C)
brew "ripgrep"       # fast grep
brew "git-delta"     # pretty git diffs (used by lazygit)
brew "lazygit"       # git TUI
brew "yazi"          # terminal file manager

# --- yazi recommended deps ---
brew "ffmpegthumbnailer"
brew "sevenzip"
brew "jq"
brew "poppler"
brew "imagemagick"
brew "resvg"

# --- zsh plugins (sourced from $HOMEBREW_PREFIX/share) ---
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-history-substring-search"
brew "zsh-completions"

# --- fonts ---
cask "font-jetbrains-mono-nerd-font"
